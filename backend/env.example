# StudyAI backend configuration template.
# Copy this file to backend/.env and fill in values. NEVER commit a real .env.
# All secrets must be provided through your platform's environment settings,
# never through this file in production.

# --- App ---
# Comma-separated origins allowed to call the API from browsers and Capacitor.
# Production: set this to your frontend's HTTPS origin, e.g.
#   CORS_ORIGINS=https://studyai.example.com,https://app.studyai.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

# --- Runtime (hosting) ---
# Set STUDYAI_ENV=production in container hosting to enforce safety checks
# (non-SQLite DATABASE_URL, STORAGE_BACKEND=s3, strong SECRET_KEY).
# PORT is provided by most platforms; startup binds to 0.0.0.0:$PORT.
STUDYAI_ENV=development
# PORT=8000

# --- Database ---
# SQLite for local development. Production requires PostgreSQL.
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
# Neon example format:
#   DATABASE_URL=postgresql+psycopg2://neondb_owner:npg_...@ep-....aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite:///./studyai.db

# --- Auth / JWT ---
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never use the default value in production.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Uploads ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# --- Storage backend ---
# "local" (default) stores files on the local filesystem.
# "s3" stores files in an S3-compatible bucket (AWS S3, MinIO, Cloudflare R2).
#   STORAGE_BACKEND=s3
#   S3_ENDPOINT_URL=https://....r2.cloudflarestorage.com
#   S3_BUCKET_NAME=your-bucket-name
#   S3_ACCESS_KEY_ID=your-access-key
#   S3_SECRET_ACCESS_KEY=your-secret-key
#   S3_REGION=us-east-1
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- AI provider (optional) ---
# Leave AI_API_KEY empty to run the app without AI generation; summary,
# quiz, and flashcard generation will return a clear "not configured"
# message instead of crashing. Supported providers: openai (any
# OpenAI-compatible endpoint) and anthropic.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
