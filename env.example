# Frontend configuration template (Vite). Copy this file to ".env" in the
# project root. These values are public by design — NEVER put secrets in
# VITE_* variables.

# Base URL of the StudyAI backend (FastAPI).
# - Local development: set it to where uvicorn is running, e.g.
#     VITE_API_URL=http://localhost:8000
#   (The backend's CORS config already allows the Vite origin.)
# - Empty: the app calls same-origin "/api/..." — only correct when the
#   built frontend is served behind the same host as the backend.
VITE_API_URL=http://localhost:8000
