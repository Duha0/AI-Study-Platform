# Example frontend environment variables (Vite).
# Copy to .env.local for overrides. .env.production is used for `npm run build`.
# Do not put secrets here; VITE_* values are embedded in client bundles.

# Deployed backend (web production / Android production builds use this or the built-in prod native fallback)
VITE_API_URL=https://studyai-api-vk7v.onrender.com

# Local development (web): leave unset/empty to use Vite dev proxy to http://localhost:8000
# VITE_API_URL=

# Local development (Android device/emulator with adb reverse): set before android dev sync/build if needed
# VITE_API_URL=http://localhost:8000
